# The board's page, running whether or not anybody is logged in.
#
# Install it, or refresh it after this file changes:
#   sudo install -m644 ~/acoustic-detection/status/status.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart status
# The first time, so that it comes back after a power cut:
#   sudo systemctl enable --now status
#
# It reads the USB bus and nothing else. It never opens the sound card, so it
# does not stand in the way of anything that wants to record.

[Unit]
Description=The board: one page saying whether it is connected
After=network.target

[Service]
User=andrei
Group=andrei
ExecStart=/usr/bin/python3 -u /home/andrei/acoustic-detection/status/status.py
# Port 80, so the address is the name and nothing after it. This is what lets an
# ordinary account bind a port below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
